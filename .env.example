# Postgres superuser name for the db container
POSTGRES_USER=nifty
# Postgres password (init-env generates a random one)
POSTGRES_PASSWORD=change-me
# Database name
POSTGRES_DB=nifty
# SQLAlchemy URL used by api/worker (compose overrides the host to 'db')
DATABASE_URL=postgresql+psycopg://nifty:change-me@127.0.0.1:5432/nifty
# Redis URL for pub/sub and cache
REDIS_URL=redis://127.0.0.1:6379/0
# Login hash; produce with `make hash-password` (keep the single quotes)
APP_PASSWORD_HASH=
# HMAC key for session cookies (init-env generates one)
APP_SECRET_KEY=
# Allowed browser origins; the first is the UI and the post-Kite-login redirect target
APP_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:5173
# Data provider: csv_replay or kite
MARKET_DATA_PROVIDER=csv_replay
# Kite Connect API key (C07)
KITE_API_KEY=
# Kite Connect API secret (C07)
KITE_API_SECRET=
# Kite OAuth redirect registered in the Kite developer console
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/v1/kite/callback
